# Скопируй в .env и заполни.

# Ник аккаунта в TikTok, с которого идёт эфир (чат читаем оттуда)
TIKTOK_USERNAME=твой_ник

# Из TikTok: адрес сервера и ключ трансляции (Server URL / Stream key)
RTMP_URL=rtmp://push-rtmp-....tiktokcdn.com/game
STREAM_KEY=вставь_ключ

# DEMO=1 — фейковые зрители вместо настоящего чата (для проверки)
DEMO=0

# Картинка: low — без видеокарты (обычный облачный сервер), high — с видеокартой
QUALITY=low
WIDTH=720
HEIGHT=1280
FPS=30
VIDEO_BITRATE=2500k
