    <Item class="ModuleScript" referent="4">
      <Properties>
        <string name="Name">RaceConfig</string>
        <string name="Source"><![CDATA[-- ModuleScript «RaceConfig» → ReplicatedStorage
-- Все настройки гонки в одном месте. Баффы (что даёт лайк, роза и т.п.)
-- настраиваются не здесь, а в config.json у моста.

return {
	-- Адрес моста (server.py). В Roblox Studio работает localhost.
	BridgeUrl = "http://localhost:8765",
	PollSeconds = 0.3,

	-- Раунд
	LobbySeconds = 25,        -- сбор участников перед стартом
	ResultsSeconds = 10,      -- показ результатов
	FinishGraceSeconds = 8,   -- сколько ждать остальных после первого финиша
	MaxRaceSeconds = 180,

	-- Трасса
	TrackLength = 500,        -- в студах (≈30 секунд бега без баффов)
	LaneWidth = 4,
	MaxRacers = 20,
	BotsFillTo = 4,           -- если зрителей мало — добиваем ботами

	-- Скорость
	BaseSpeed = 16,           -- обычная скорость ходьбы в Roblox
	SpeedJitter = 0.08,       -- случайный разброс базовой скорости (±8%)
	MaxSpeedMultiplier = 4,
	JumpStudsPerSecond = 120, -- как быстро пролетает «рывок»/джетпак

	-- Камера (для вертикального стрима сузь окно Studio до 9:16)
	CameraBack = 55,
	CameraHeight = 38,
	CameraFov = 70,
}
]]></string>
      </Properties>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="5">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="6">
      <Properties>
        <string name="Name">RaceServer</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- Script «RaceServer» → ServerScriptService
-- Строит трассу, забирает события чата у моста (server.py) и проводит забеги:
-- лобби (сбор участников) → гонка → результаты → снова лобби.

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local PhysicsService = game:GetService("PhysicsService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage:WaitForChild("RaceConfig"))

-- Стример только смотрит: своего персонажа у него нет, камерой управляет RaceClient.
Players.CharacterAutoLoads = false

-- Состояние для клиента (UI и камера) — атрибуты этой папки.
local State = Instance.new("Folder")
State.Name = "RaceState"
State.Parent = ReplicatedStorage

local FeedEvent = Instance.new("RemoteEvent")
FeedEvent.Name = "RaceFeed"
FeedEvent.Parent = ReplicatedStorage

pcall(function()
	PhysicsService:RegisterCollisionGroup("Racers")
end)
PhysicsService:CollisionGroupSetCollidable("Racers", "Racers", false)

local L = Config.TrackLength
local MAX = Config.MaxRacers
local WIDTH = MAX * Config.LaneWidth + 8
local START_X = 0
local FINISH_X = L

local function now()
	return workspace:GetServerTimeNow()
end

local function colorFor(id: string): Color3
	local h = 0
	for _, c in utf8.codes(id) do
		h = (h * 31 + c) % 2147483647
	end
	return Color3.fromHSV((h % 360) / 360, 0.65, 0.95)
end

local function feed(text: string, color: Color3?)
	FeedEvent:FireAllClients(text, (color or Color3.new(1, 1, 1)):ToHex())
end

-------------------------------------------------------------------------------
-- Трасса
-------------------------------------------------------------------------------

local Track = Instance.new("Model")
Track.Name = "RaceTrack"
Track.Parent = workspace

local RacersFolder = Instance.new("Folder")
RacersFolder.Name = "Racers"
RacersFolder.Parent = Track

local function block(name, size, cframe, color, material)
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.CFrame = cframe
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = Track
	return p
end

local function sign(part: BasePart, face: Enum.NormalId, text: string, color: Color3)
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 20
	gui.Parent = part
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextScaled = true
	label.Font = Enum.Font.FredokaOne
	label.TextColor3 = color
	label.TextStrokeTransparency = 0
	label.Parent = gui
end

local function gantry(x: number, text: string, color: Color3)
	local h = 16
	for _, side in { -1, 1 } do
		block("Pole", Vector3.new(1.5, h, 1.5), CFrame.new(x, h / 2, side * (WIDTH / 2 + 1)), Color3.fromRGB(40, 40, 40))
	end
	local beam = block("Banner", Vector3.new(1.5, 5, WIDTH + 4), CFrame.new(x, h + 1, 0), color)
	sign(beam, Enum.NormalId.Left, text, Color3.new(1, 1, 1))
	sign(beam, Enum.NormalId.Right, text, Color3.new(1, 1, 1))
end

do
	block("Grass", Vector3.new(L + 600, 1, WIDTH + 400), CFrame.new(L / 2, -0.6, 0),
		Color3.fromRGB(76, 153, 62), Enum.Material.Grass)
	-- дорога: верх на высоте 0, от x=-40 до финиша +60
	block("Road", Vector3.new(L + 100, 1, WIDTH), CFrame.new((L + 20) / 2, -0.5, 0),
		Color3.fromRGB(60, 60, 70), Enum.Material.Asphalt)
	for _, side in { -1, 1 } do
		block("Barrier", Vector3.new(L + 100, 2, 1), CFrame.new((L + 20) / 2, 1, side * (WIDTH / 2 + 0.5)),
			side < 0 and Color3.fromRGB(230, 60, 60) or Color3.fromRGB(240, 240, 240))
	end
	for i = 0, MAX do
		local z = (i - MAX / 2) * Config.LaneWidth
		block("LaneLine", Vector3.new(L, 0.05, 0.2), CFrame.new(L / 2, 0.03, z), Color3.fromRGB(200, 200, 200))
	end
	block("StartLine", Vector3.new(1, 0.06, WIDTH), CFrame.new(START_X, 0.03, 0), Color3.new(1, 1, 1))
	-- финиш в шашечку
	local sq = 2
	local n = math.ceil(WIDTH / sq)
	for row = 0, n - 1 do
		for col = 0, 1 do
			local white = (row + col) % 2 == 0
			block("Finish", Vector3.new(sq, 0.06, sq),
				CFrame.new(FINISH_X + col * sq, 0.04, -WIDTH / 2 + sq / 2 + row * sq),
				white and Color3.new(1, 1, 1) or Color3.new(0.1, 0.1, 0.1))
		end
	end
	gantry(START_X, "СТАРТ", Color3.fromRGB(40, 120, 255))
	gantry(FINISH_X, "🏁 ФИНИШ 🏁", Color3.fromRGB(255, 70, 70))
end

-- Дорожки занимаются от центра к краям, чтобы бегуны были в кадре.
local laneOrder = {}
for i = 1, MAX do
	table.insert(laneOrder, i)
end
table.sort(laneOrder, function(a, b)
	return math.abs(a - (MAX + 1) / 2) < math.abs(b - (MAX + 1) / 2)
end)

local function laneZ(slot: number): number
	return (slot - (MAX + 1) / 2) * Config.LaneWidth
end

-------------------------------------------------------------------------------
-- Бегуны
-------------------------------------------------------------------------------

local racers = {}      -- текущий забег
local byId = {}        -- id → racer
local queue = {}       -- ждут следующего забега: { {user, pending} }
local queueById = {}
local skins = {}       -- id зрителя → ник Roblox (помним весь стрим)
local userIdCache = {} -- ник Roblox → userId или false
local wins = {}        -- id → {name, n}

local phase = "lobby"
local phaseEnd = 0
local raceStart = 0
local firstFinish = nil
local finishedCount = 0
local round = 0
local botsAdded = false

local function publish()
	State:SetAttribute("Phase", phase)
	State:SetAttribute("PhaseEnd", phaseEnd)
	State:SetAttribute("Round", round)
	State:SetAttribute("Racers", #racers)
	State:SetAttribute("MaxRacers", MAX)
	State:SetAttribute("Queue", #queue)
end

local function resolveUserId(name: string): number?
	if userIdCache[name] == nil then
		local ok, id = pcall(Players.GetUserIdFromNameAsync, Players, name)
		userIdCache[name] = ok and id or false
	end
	return userIdCache[name] or nil
end

local function makeModel(r)
	local model
	if r.robloxName then
		local userId = resolveUserId(r.robloxName)
		if userId then
			local ok, m = pcall(Players.CreateHumanoidModelFromUserId, Players, userId)
			if ok then
				model = m
			end
		end
	end
	if not model then
		local c = colorFor(r.id)
		local d = Instance.new("HumanoidDescription")
		d.HeadColor = Color3.fromRGB(255, 214, 170)
		d.TorsoColor = c
		d.LeftArmColor = c
		d.RightArmColor = c
		d.LeftLegColor = c:Lerp(Color3.new(0, 0, 0), 0.45)
		d.RightLegColor = c:Lerp(Color3.new(0, 0, 0), 0.45)
		local ok, m = pcall(Players.CreateHumanoidModelFromDescription, Players, d, Enum.HumanoidRigType.R15)
		if not ok then
			warn("не удалось создать бегуна:", m)
			return nil
		end
		model = m
	end
	model.Name = r.name

	local hum = model:FindFirstChildOfClass("Humanoid")
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	hum.WalkSpeed = 0
	for _, p in model:GetDescendants() do
		if p:IsA("BasePart") then
			p.CollisionGroup = "Racers"
		end
	end

	local head = model:FindFirstChild("Head")
	local tag = Instance.new("BillboardGui")
	tag.Name = "NameTag"
	tag.Size = UDim2.fromOffset(240, 46)
	tag.StudsOffset = Vector3.new(0, 2.6, 0)
	tag.AlwaysOnTop = true
	tag.MaxDistance = 250
	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = r.name
	label.TextScaled = true
	label.Font = Enum.Font.FredokaOne
	label.TextColor3 = r.bot and Color3.fromRGB(190, 190, 190) or Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0
	label.Parent = tag
	tag.Parent = head

	local root = model:FindFirstChild("HumanoidRootPart")
	local fire = Instance.new("Fire")
	fire.Enabled = false
	fire.Size = 5
	fire.Heat = 8
	fire.Parent = root
	local sparkles = Instance.new("Sparkles")
	sparkles.Enabled = false
	sparkles.SparkleColor = Color3.fromRGB(120, 220, 255)
	sparkles.Parent = root

	local start = Vector3.new(START_X - 3, 3.5, r.z)
	model:PivotTo(CFrame.lookAt(start, start + Vector3.xAxis))
	model.Parent = RacersFolder
	pcall(root.SetNetworkOwner, root, nil)
	return model, hum, root, fire, sparkles, label
end

-- Модель грузится с задержкой (скин качается с серверов Roblox), поэтому
-- создаём её в отдельном потоке; build защищает от устаревших загрузок.
local function spawnModel(r)
	r.build += 1
	local build = r.build
	if r.model then
		r.model:Destroy()
		r.model = nil
	end
	task.spawn(function()
		local model, hum, root, fire, sparkles, label = makeModel(r)
		if not model then
			return
		end
		if r.removed or build ~= r.build then
			model:Destroy()
			return
		end
		r.model, r.hum, r.root, r.fire, r.sparkles, r.label = model, hum, root, fire, sparkles, label
		r.lastMove = 0
	end)
end

local function takeSlot(): number
	local used = {}
	for _, r in racers do
		used[r.slot] = true
	end
	for _, slot in laneOrder do
		if not used[slot] then
			return slot
		end
	end
	return laneOrder[#laneOrder]
end

local function addRacer(user, robloxName, pending, bot)
	local r = {
		id = user.id, name = user.name, bot = bot or false, robloxName = robloxName,
		pending = pending or {}, boosts = {}, jumpLeft = 0, build = 0, lastMove = 0,
		base = Config.BaseSpeed, wf = 0.7 + math.random() * 0.8, wp = math.random() * 6.28,
	}
	r.slot = takeSlot()
	r.z = laneZ(r.slot)
	table.insert(racers, r)
	byId[r.id] = r
	spawnModel(r)
	return r
end

local function removeRacer(r)
	r.removed = true
	if r.model then
		r.model:Destroy()
	end
	table.remove(racers, table.find(racers, r))
	byId[r.id] = nil
end

local function clearRacers()
	for _, r in racers do
		r.removed = true
		if r.model then
			r.model:Destroy()
		end
	end
	racers = {}
	byId = {}
end

local function takeFromQueue(id: string)
	local q = queueById[id]
	if q then
		queueById[id] = nil
		table.remove(queue, table.find(queue, q))
	end
	return q
end

local function enqueue(user, effect, count)
	local q = queueById[user.id]
	if not q then
		q = { user = user, pending = {} }
		queueById[user.id] = q
		table.insert(queue, q)
	end
	q.user = user
	if effect and #q.pending < 20 then
		table.insert(q.pending, { effect = effect, count = count })
	end
	publish()
end

local function applyEffect(r, effect, count, t)
	count = math.clamp(math.floor(count or 1), 1, 10)
	if effect.kind == "boost" then
		table.insert(r.boosts, { mult = effect.multiplier, ends = t + effect.seconds * count })
	elseif effect.kind == "jump" then
		r.jumpLeft += (effect.studs or 0) * count
	end
end

-------------------------------------------------------------------------------
-- Фазы
-------------------------------------------------------------------------------

local function startLobby()
	clearRacers()
	local waiting = queue
	queue, queueById = {}, {}
	for _, q in waiting do
		if #racers < MAX then
			addRacer(q.user, skins[q.user.id], q.pending)
		else
			queue[#queue + 1] = q
			queueById[q.user.id] = q
		end
	end
	phase = "lobby"
	phaseEnd = now() + Config.LobbySeconds
	botsAdded = false
	State:SetAttribute("Leader", "")
	publish()
end

local function addBots()
	botsAdded = true
	local b = 1
	while #racers < Config.BotsFillTo do
		addRacer({ id = "__bot" .. b, name = "Бот " .. b }, nil, nil, true)
		b += 1
	end
	publish()
end

local function startRace()
	round += 1
	local t = now()
	for _, r in racers do
		local jitter = 1 + (math.random() * 2 - 1) * Config.SpeedJitter
		r.base = Config.BaseSpeed * jitter * (r.bot and 0.97 or 1)
		for _, p in r.pending do
			applyEffect(r, p.effect, p.count, t)
		end
		r.pending = {}
		r.lastMove = 0
	end
	phase = "race"
	raceStart = t
	firstFinish = nil
	finishedCount = 0
	publish()
	feed("🏁 СТАРТ! Забег #" .. round, Color3.fromRGB(255, 225, 77))
end

local function xOf(r): number
	return r.root and r.root.Position.X or START_X
end

local function endRace()
	local sorted = table.clone(racers)
	table.sort(sorted, function(a, b)
		local pa, pb = a.place or math.huge, b.place or math.huge
		if pa ~= pb then
			return pa < pb
		end
		return xOf(a) > xOf(b)
	end)

	local results = {}
	for i = 1, math.min(5, #sorted) do
		local r = sorted[i]
		local result = r.finish and string.format("%.1f с", r.finish)
			or string.format("%d%%", math.clamp(math.floor(xOf(r) / L * 100), 0, 99))
		results[i] = { name = r.name, result = result, color = colorFor(r.id):ToHex() }
	end

	local winner = sorted[1]
	if winner and winner.place == 1 and not winner.bot then
		local w = wins[winner.id] or { name = winner.name, n = 0 }
		w.n += 1
		w.name = winner.name
		wins[winner.id] = w
	end
	local champions = {}
	for _, w in wins do
		table.insert(champions, w)
	end
	table.sort(champions, function(a, b)
		return a.n > b.n
	end)

	for _, r in racers do
		if r.hum and not r.place then
			r.hum.WalkSpeed = 0
		end
	end

	State:SetAttribute("Results", HttpService:JSONEncode(results))
	State:SetAttribute("Champions", HttpService:JSONEncode({ table.unpack(champions, 1, 3) }))
	phase = "results"
	phaseEnd = now() + Config.ResultsSeconds
	publish()
end

local MEDALS = { "🥇", "🥈", "🥉" }

local function updateRace(dt: number, t: number)
	local leader, leaderX = nil, -math.huge
	for _, r in racers do
		local mult = 1
		local i = 1
		while i <= #r.boosts do
			if r.boosts[i].ends <= t then
				table.remove(r.boosts, i)
			else
				mult += r.boosts[i].mult - 1
				i += 1
			end
		end
		mult = math.min(mult, Config.MaxSpeedMultiplier)

		if r.model and r.root.Parent then
			if not r.place then
				local wobble = 1 + 0.1 * math.sin(t * r.wf + r.wp)
				r.hum.WalkSpeed = r.base * mult * wobble
				if r.jumpLeft > 0 then
					local step = math.min(r.jumpLeft, Config.JumpStudsPerSecond * dt)
					r.jumpLeft -= step
					r.model:PivotTo(r.model:GetPivot() + Vector3.new(step, 0, 0))
				end
				-- MoveTo сам сбрасывается через 8 секунд, поэтому повторяем
				if t - r.lastMove > 1 then
					r.hum:MoveTo(Vector3.new(FINISH_X + 30, 0, r.z))
					r.lastMove = t
				end
				if r.root.Position.X >= FINISH_X then
					finishedCount += 1
					r.place = finishedCount
					r.finish = t - raceStart
					r.jumpLeft = 0
					firstFinish = firstFinish or t
					r.hum:MoveTo(Vector3.new(FINISH_X + 12, 0, r.z))
					r.hum.WalkSpeed = 10
					r.hum.Jump = true
					local medal = MEDALS[r.place]
					r.label.Text = (medal or ("#" .. r.place)) .. " " .. r.name
					if medal then
						feed(medal .. " " .. r.name .. " — " .. string.format("%.1f с", r.finish), colorFor(r.id))
					end
				end
			end
			r.fire.Enabled = not r.place and mult > 1.3
			r.sparkles.Enabled = r.jumpLeft > 0
			local x = r.place and (FINISH_X + 1000 - r.place) or r.root.Position.X
			if x > leaderX then
				leader, leaderX = r, x
			end
		end
	end
	if leader then
		State:SetAttribute("Leader", leader.name)
	end

	local allDone = true
	for _, r in racers do
		if not r.place then
			allDone = false
			break
		end
	end
	local graceOver = firstFinish and t - firstFinish > Config.FinishGraceSeconds
	if allDone or graceOver or t - raceStart > Config.MaxRaceSeconds then
		endRace()
	end
end

RunService.Heartbeat:Connect(function(dt)
	local t = now()
	if phase == "lobby" then
		if not botsAdded and t > phaseEnd - 5 then
			addBots()
		end
		if t >= phaseEnd then
			startRace()
		end
	elseif phase == "race" then
		updateRace(dt, t)
	elseif phase == "results" and t >= phaseEnd then
		startLobby()
	end
end)

-------------------------------------------------------------------------------
-- События чата
-------------------------------------------------------------------------------

-- Зритель хочет бежать: в лобби — сразу на старт, иначе — в следующий забег.
local function onJoin(user, robloxName)
	if robloxName then
		skins[user.id] = robloxName
	end
	local skin = skins[user.id]
	if phase == "lobby" then
		local r = byId[user.id]
		if r then
			if skin ~= r.robloxName then
				r.robloxName = skin
				spawnModel(r)
			end
			return r
		end
		if #racers < MAX then
			local q = takeFromQueue(user.id)
			r = addRacer(user, skin, q and q.pending)
			feed(user.name .. " в забеге!", colorFor(user.id))
			-- живой зритель вытесняет бота, если ботов звали «для массовки»
			if #racers > Config.BotsFillTo then
				for i = #racers, 1, -1 do
					if racers[i].bot then
						removeRacer(racers[i])
						break
					end
				end
			end
			publish()
			return r
		end
	end
	enqueue(user)
	return nil
end

local function onEffect(user, effect, count)
	local r = byId[user.id]
	if phase == "race" and r and not r.place then
		applyEffect(r, effect, count, now())
	elseif phase == "lobby" then
		r = onJoin(user, nil)
		if r and #r.pending < 20 then
			table.insert(r.pending, { effect = effect, count = count })
		elseif not r then
			enqueue(user, effect, count)
		end
	else
		enqueue(user, effect, count)
	end
	if effect.kind ~= "boost" or effect.multiplier >= 1.5 then
		feed(user.name .. ": " .. effect.label, colorFor(user.id))
	end
end

local function handleEvent(ev)
	if ev.type == "join" then
		onJoin(ev.user, ev.roblox)
	elseif ev.type == "effect" then
		onEffect(ev.user, ev.effect, ev.count or 1)
	end
end

-- Опрос моста. after=-1 — «я только запустился, дай номер последнего события».
task.spawn(function()
	local okRead, enabled = pcall(function()
		return HttpService.HttpEnabled
	end)
	if okRead and not enabled then
		State:SetAttribute("Status", "Включи HTTP: Game Settings → Security → Allow HTTP Requests")
		warn("[Гонка] HTTP-запросы выключены: Game Settings → Security → Allow HTTP Requests")
	end
	local last = -1
	while true do
		local ok, res = pcall(HttpService.GetAsync, HttpService,
			Config.BridgeUrl .. "/events?after=" .. last, true)
		if ok then
			local data = HttpService:JSONDecode(res)
			State:SetAttribute("Status", data.status)
			State:SetAttribute("Legend", HttpService:JSONEncode(data.legend))
			if last < 0 or data.last < last then
				last = data.last
			end
			for _, ev in data.events do
				last = math.max(last, ev.seq)
				local okEvent, err = pcall(handleEvent, ev)
				if not okEvent then
					warn("[Гонка] ошибка события:", err)
				end
			end
		else
			State:SetAttribute("Status", "нет связи с мостом — запущен ли server.py?")
			warn("[Гонка] мост недоступен:", res)
			task.wait(2)
		end
		task.wait(Config.PollSeconds)
	end
end)

startLobby()
]]></string>
      </Properties>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="7">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="8">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="9">
        <Properties>
          <string name="Name">RaceClient</string>
          <string name="Source"><![CDATA[-- LocalScript «RaceClient» → StarterPlayer › StarterPlayerScripts
-- Камера, которая едет за бегунами, и надписи поверх игры: таймер, подсказка
-- по баффам, лента событий и результаты.

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")

local Config = require(ReplicatedStorage:WaitForChild("RaceConfig"))
local State = ReplicatedStorage:WaitForChild("RaceState")
local FeedEvent = ReplicatedStorage:WaitForChild("RaceFeed")
local RacersFolder = workspace:WaitForChild("RaceTrack"):WaitForChild("Racers")
local player = Players.LocalPlayer

task.spawn(function()
	for _ = 1, 10 do
		if pcall(StarterGui.SetCoreGuiEnabled, StarterGui, Enum.CoreGuiType.All, false) then
			break
		end
		task.wait(0.5)
	end
end)

-------------------------------------------------------------------------------
-- Камера
-------------------------------------------------------------------------------

local camera = workspace.CurrentCamera
local focusX = 0

RunService:BindToRenderStep("RaceCamera", Enum.RenderPriority.Camera.Value + 1, function(dt)
	camera.CameraType = Enum.CameraType.Scriptable
	camera.FieldOfView = Config.CameraFov
	local target = -10
	local phase = State:GetAttribute("Phase")
	if phase == "race" or phase == "results" then
		local maxX, sumX, n = -math.huge, 0, 0
		for _, model in RacersFolder:GetChildren() do
			local root = model:FindFirstChild("HumanoidRootPart")
			if root then
				maxX = math.max(maxX, root.Position.X)
				sumX += root.Position.X
				n += 1
			end
		end
		if n > 0 then
			-- держим в кадре середину толпы, но не теряем лидера
			target = math.max(sumX / n, maxX - 60)
		end
	end
	focusX += (target - focusX) * math.min(1, dt * 2.5)
	local eye = Vector3.new(focusX - Config.CameraBack, Config.CameraHeight, 0)
	camera.CFrame = CFrame.lookAt(eye, Vector3.new(focusX + 20, 0, 0))
end)

-------------------------------------------------------------------------------
-- Интерфейс
-------------------------------------------------------------------------------

local gui = Instance.new("ScreenGui")
gui.Name = "RaceUI"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.Parent = player:WaitForChild("PlayerGui")

local function label(props): TextLabel
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Font = Enum.Font.FredokaOne
	l.TextColor3 = Color3.new(1, 1, 1)
	l.TextScaled = true
	l.TextStrokeTransparency = 0.2
	for k, v in props do
		l[k] = v
	end
	return l
end

local function panel(props): Frame
	local f = Instance.new("Frame")
	f.BackgroundColor3 = Color3.fromRGB(10, 12, 30)
	f.BackgroundTransparency = 0.35
	f.BorderSizePixel = 0
	for k, v in props do
		f[k] = v
	end
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 14)
	corner.Parent = f
	return f
end

local title = label({
	Text = "🏁 ГОНКА ЧАТА 🏁", TextColor3 = Color3.fromRGB(255, 225, 77),
	Size = UDim2.fromScale(0.9, 0.06), Position = UDim2.fromScale(0.05, 0.015), Parent = gui,
})
local phaseLine = label({
	Text = "", Size = UDim2.fromScale(0.9, 0.04), Position = UDim2.fromScale(0.05, 0.08), Parent = gui,
})
local queueLine = label({
	Text = "", TextColor3 = Color3.fromRGB(160, 215, 255),
	Size = UDim2.fromScale(0.9, 0.028), Position = UDim2.fromScale(0.05, 0.122), Parent = gui,
})

local legendBox = panel({ Size = UDim2.fromScale(0.94, 0.2), Position = UDim2.fromScale(0.03, 0.16), Parent = gui })
local legendLayout = Instance.new("UIListLayout")
legendLayout.Padding = UDim.new(0, 2)
legendLayout.SortOrder = Enum.SortOrder.LayoutOrder
legendLayout.Parent = legendBox
local legendPad = Instance.new("UIPadding")
legendPad.PaddingLeft = UDim.new(0, 12)
legendPad.PaddingTop = UDim.new(0, 6)
legendPad.Parent = legendBox

local function rebuildLegend()
	for _, c in legendBox:GetChildren() do
		if c:IsA("TextLabel") then
			c:Destroy()
		end
	end
	local raw = State:GetAttribute("Legend")
	if not raw then
		return
	end
	local lines = HttpService:JSONDecode(raw)
	local h = 1 / math.max(#lines, 1)
	for i, line in lines do
		label({
			Text = line, LayoutOrder = i, TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = i == 1 and Color3.fromRGB(255, 225, 77) or Color3.fromRGB(230, 235, 255),
			Size = UDim2.new(1, -12, h, -3), Parent = legendBox,
		})
	end
end
State:GetAttributeChangedSignal("Legend"):Connect(rebuildLegend)
rebuildLegend()

local hint = label({
	Text = "Пиши в чат, чтобы участвовать!", TextColor3 = Color3.fromRGB(255, 225, 77),
	Size = UDim2.fromScale(0.9, 0.06), Position = UDim2.fromScale(0.05, 0.5), Visible = false, Parent = gui,
})

local status = label({
	Text = "", TextColor3 = Color3.fromRGB(200, 200, 200), TextTransparency = 0.3,
	Size = UDim2.fromScale(0.9, 0.022), Position = UDim2.fromScale(0.05, 0.972), Parent = gui,
})

-- Лента событий внизу
local feedBox = Instance.new("Frame")
feedBox.BackgroundTransparency = 1
feedBox.Size = UDim2.fromScale(0.94, 0.25)
feedBox.Position = UDim2.fromScale(0.03, 0.715)
feedBox.Parent = gui
local feedLayout = Instance.new("UIListLayout")
feedLayout.Padding = UDim.new(0, 4)
feedLayout.SortOrder = Enum.SortOrder.LayoutOrder
feedLayout.VerticalAlignment = Enum.VerticalAlignment.Bottom
feedLayout.Parent = feedBox
local feedOrder = 0
local FEED_MAX = 6

FeedEvent.OnClientEvent:Connect(function(text: string, colorHex: string)
	feedOrder += 1
	local row = panel({ Size = UDim2.new(1, 0, 1 / FEED_MAX, -4), LayoutOrder = feedOrder, Parent = feedBox })
	label({
		Text = text, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Color3.fromHex(colorHex),
		Size = UDim2.new(1, -24, 0.8, 0), Position = UDim2.new(0, 12, 0.1, 0), Parent = row,
	})
	local rows = {}
	for _, c in feedBox:GetChildren() do
		if c:IsA("Frame") then
			table.insert(rows, c)
		end
	end
	table.sort(rows, function(a, b)
		return a.LayoutOrder < b.LayoutOrder
	end)
	for i = 1, #rows - FEED_MAX do
		rows[i]:Destroy()
	end
	task.delay(10, function()
		if row.Parent then
			row:Destroy()
		end
	end)
end)

-- Результаты
local resultsBox = panel({
	Size = UDim2.fromScale(0.9, 0.5), Position = UDim2.fromScale(0.05, 0.2),
	BackgroundTransparency = 0.1, Visible = false, Parent = gui,
})

local MEDALS = { "🥇", "🥈", "🥉", "4.", "5." }

local function showResults()
	resultsBox:ClearAllChildren()
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 14)
	corner.Parent = resultsBox
	label({
		Text = "🏆 РЕЗУЛЬТАТЫ", TextColor3 = Color3.fromRGB(255, 225, 77),
		Size = UDim2.fromScale(0.9, 0.12), Position = UDim2.fromScale(0.05, 0.03), Parent = resultsBox,
	})
	local results = HttpService:JSONDecode(State:GetAttribute("Results") or "[]")
	for i, r in results do
		local y = 0.17 + (i - 1) * 0.105
		label({
			Text = MEDALS[i] .. " " .. r.name, TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = Color3.fromHex(r.color),
			Size = UDim2.fromScale(0.68, 0.09), Position = UDim2.fromScale(0.05, y), Parent = resultsBox,
		})
		label({
			Text = r.result, TextXAlignment = Enum.TextXAlignment.Right,
			Size = UDim2.fromScale(0.22, 0.08), Position = UDim2.fromScale(0.73, y), Parent = resultsBox,
		})
	end
	local champions = HttpService:JSONDecode(State:GetAttribute("Champions") or "[]")
	if #champions > 0 then
		label({
			Text = "Чемпионы стрима", TextColor3 = Color3.fromRGB(160, 215, 255),
			Size = UDim2.fromScale(0.9, 0.07), Position = UDim2.fromScale(0.05, 0.71), Parent = resultsBox,
		})
		for i, c in champions do
			label({
				Text = c.name .. " — побед: " .. c.n,
				Size = UDim2.fromScale(0.9, 0.055), Position = UDim2.fromScale(0.05, 0.72 + i * 0.065), Parent = resultsBox,
			})
		end
	end
end

local shownPhase = nil
RunService.RenderStepped:Connect(function()
	local phase = State:GetAttribute("Phase")
	local left = math.max(0, math.ceil((State:GetAttribute("PhaseEnd") or 0) - workspace:GetServerTimeNow()))
	local racers = State:GetAttribute("Racers") or 0
	if phase == "lobby" then
		phaseLine.Text = string.format("Старт через %dс · бегунов: %d/%d", left, racers, State:GetAttribute("MaxRacers") or 0)
	elseif phase == "race" then
		phaseLine.Text = string.format("Забег #%d · лидер: %s", State:GetAttribute("Round") or 0, State:GetAttribute("Leader") or "—")
	elseif phase == "results" then
		phaseLine.Text = string.format("Финиш! Новый забег через %dс", left)
	end
	local q = State:GetAttribute("Queue") or 0
	queueLine.Text = (q > 0 and phase ~= "lobby") and ("В очереди на следующий забег: " .. q) or ""
	hint.Visible = phase == "lobby" and racers == 0
	status.Text = State:GetAttribute("Status") or ""

	if phase ~= shownPhase then
		shownPhase = phase
		resultsBox.Visible = phase == "results"
		if phase == "results" then
			showResults()
		end
	end
end)
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
</roblox>