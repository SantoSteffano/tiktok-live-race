{
  "name": "ChatRace",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "RaceConfig": { "$path": "RaceConfig.lua" }
    },
    "ServerScriptService": {
      "RaceServer": { "$path": "RaceServer.server.lua" }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "RaceClient": { "$path": "RaceClient.client.lua" }
      }
    },
    "HttpService": {
      "$properties": { "HttpEnabled": true }
    },
    "Players": {
      "$properties": { "CharacterAutoLoads": false }
    },
    "Lighting": {
      "$properties": { "ClockTime": 14.5, "Brightness": 2 }
    }
  }
}
